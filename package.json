{
  "name": "cartura",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:setup": "pnpm --filter @cartura/backend dev:setup",
    "dev:backend": "pnpm redis:up && pnpm --parallel --filter @cartura/contracts --filter @cartura/backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:frontend:immediate": "pnpm --filter frontend dev:immediate",
    "redis:up": "docker compose -f compose.redis.yml up -d --build --wait redis",
    "redis:down": "docker compose -f compose.redis.yml down",
    "redis:logs": "docker compose -f compose.redis.yml logs -f redis",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
