{
  "name": "@cartura/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma db seed && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test src/infrastructure/storage/cloudinary-storage.test.ts src/infrastructure/cache/cache.service.test.ts src/modules/catalog/products/products.repository.test.ts src/modules/analytics/analytics.utils.test.ts src/modules/orders/orders.policy.test.ts src/modules/payments/payments.paymob.test.ts src/modules/refunds/refunds.policy.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.20",
    "@cartura/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.20",
    "bullmq": "^5.80.10",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
