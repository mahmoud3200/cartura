generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuthSession {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccountBetter {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts_better")
}

model AuthVerification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthTwoFactor {
  id          String  @id @default(uuid())
  secret      String
  backupCodes String
  userId      String  @db.Uuid
  verified    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_two_factors")
}

model Jwks {
  id         String    @id @default(uuid())
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String    @unique
  emailVerified       Boolean   @default(false) @map("email_verified")
  image               String?
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  accountStatus       String    @default("active") @map("account_status")
  accountStatusReason String?   @map("account_status_reason")
  suspendedUntil      DateTime? @map("suspended_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions            AuthSession[]
  accounts            AuthAccountBetter[]
  twoFactors          AuthTwoFactor[]
  addresses           Address[]
  assignedRole        UserRole?            @relation("UserRoles")
  roleAssignments     UserRole[]           @relation("AssignedRoles")
  createdCategories   Category[]           @relation("CategoryCreator")
  createdProducts     Product[]            @relation("ProductCreator")
  uploadedMediaAssets MediaAsset[]         @relation("MediaAssetUploader")
  cart                Cart?
  orders              Order[]
  orderStatusChanges  OrderStatusHistory[] @relation("OrderStatusChanger")
  initiatedRefunds    Refund[]             @relation("RefundInitiator")
  reviewedRefunds     Refund[]             @relation("RefundReviewer")
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([createdAt])
  @@map("users")
}

model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  addressName   String   @map("address_name")
  recipientName String   @map("recipient_name")
  phoneNumber   String   @map("phone_number")
  country       String
  city          String
  area          String
  streetAddress String   @map("street_address")
  postalCode    String?  @map("postal_code")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Role {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @id @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user     User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("AssignedRoles", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Category {
  id               String   @id @default(uuid(7)) @db.Uuid
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  name             String
  slug             String   @unique
  description      String?
  imageUrl         String?  @map("image_url")
  imageAssetId     String?  @unique @map("image_asset_id") @db.Uuid
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parent     Category?         @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children   Category[]        @relation("CategoryTree")
  creator    User?             @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  imageAsset MediaAsset?       @relation("CategoryImageAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)
  products   ProductCategory[]

  @@index([parentCategoryId])
  @@index([createdBy])
  @@index([isDeleted, parentCategoryId])
  @@index([imageAssetId])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String
  description   String?
  sku           String
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator    User?             @relation("ProductCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  categories ProductCategory[]
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([createdBy])
  @@index([isDeleted, createdAt])
  @@index([slug, isDeleted])
  @@index([sku, isDeleted])
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  mediaAssetId String?  @unique @map("media_asset_id") @db.Uuid
  imageUrl     String   @map("image_url")
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("ProductImageMediaAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productId, displayOrder])
  @@index([mediaAssetId])
  @@map("product_images")
}

model MediaAsset {
  id                   String    @id @default(uuid(7)) @db.Uuid
  provider             String    @default("cloudinary")
  publicId             String    @unique @map("public_id")
  secureUrl            String    @map("secure_url")
  canonicalUrl         String    @map("canonical_url")
  usage                String
  status               String    @default("pending")
  mimeType             String    @map("mime_type")
  format               String
  bytes                Int
  width                Int
  height               Int
  editSpec             Json?     @map("edit_spec")
  variants             Json?
  uploadedBy           String?   @map("uploaded_by") @db.Uuid
  attachedResourceType String?   @map("attached_resource_type")
  attachedResourceId   String?   @map("attached_resource_id") @db.Uuid
  attachedAt           DateTime? @map("attached_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  uploader     User?         @relation("MediaAssetUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  category     Category?     @relation("CategoryImageAsset")
  productImage ProductImage? @relation("ProductImageMediaAsset")

  @@index([uploadedBy])
  @@index([status, createdAt])
  @@index([usage, status])
  @@index([attachedResourceType, attachedResourceId])
  @@map("media_assets")
}

model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  orderNumber    String    @unique @map("order_number")
  status         String
  subtotal       Decimal   @db.Decimal(12, 2)
  shippingCost   Decimal   @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(12, 2)
  currency       String    @default("USD")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")
  cancelledAt    DateTime? @map("cancelled_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  address       OrderAddress?
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payment       Payment?

  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderAddress {
  orderId       String  @id @map("order_id") @db.Uuid
  recipientName String  @map("recipient_name")
  phoneNumber   String  @map("phone_number")
  country       String
  city          String
  area          String
  streetAddress String  @map("street_address")
  postalCode    String? @map("postal_code")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name")
  productSku  String  @map("product_sku")
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  changedBy      String?  @map("changed_by") @db.Uuid
  actorType      String   @map("actor_type")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User? @relation("OrderStatusChanger", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id                    String    @id @default(uuid(7)) @db.Uuid
  orderId               String    @unique @map("order_id") @db.Uuid
  provider              String
  providerTransactionId String?   @map("provider_transaction_id")
  idempotencyKey        String    @unique @map("idempotency_key")
  paymentMethod         String    @map("payment_method")
  status                String
  amount                Decimal   @db.Decimal(12, 2)
  currency              String
  failureReason         String?   @map("failure_reason")
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  paidAt                DateTime? @map("paid_at")
  refundedAt            DateTime? @map("refunded_at")

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]
  refunds       Refund[]

  @@index([status])
  @@index([status, paidAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  paymentId       String?   @map("payment_id") @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  eventType       String    @map("event_type")
  status          String
  attempts        Int       @default(0)
  payload         Json
  failureReason   String?   @map("failure_reason")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model Refund {
  id                String    @id @default(uuid(7)) @db.Uuid
  paymentId         String    @map("payment_id") @db.Uuid
  initiatedBy       String?   @map("initiated_by") @db.Uuid
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  providerRefundId  String?   @map("provider_refund_id")
  amount            Decimal   @db.Decimal(12, 2)
  currency          String
  status            String
  reason            String?
  reasonCode        String?   @map("reason_code")
  reviewNote        String?   @map("review_note")
  resolution        String?
  refundMethod      String    @map("refund_method")
  failureReason     String?   @map("failure_reason")
  pickupScheduledAt DateTime? @map("pickup_scheduled_at")
  itemReceivedAt    DateTime? @map("item_received_at")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")
  failedAt          DateTime? @map("failed_at")

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  initiator User?   @relation("RefundInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)
  reviewer  User?   @relation("RefundReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([createdAt])
  @@index([status])
  @@index([status, completedAt])
  @@index([reviewedBy])
  @@map("refunds")
}

model Notification {
  id            String    @id @default(uuid(7)) @db.Uuid
  sourceEventId String?   @unique @map("source_event_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  type          String
  title         String
  body          String
  data          Json?
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String    @id @default(uuid(7)) @db.Uuid
  notificationId    String    @map("notification_id") @db.Uuid
  channel           String
  recipient         String
  status            String
  attempts          Int       @default(0)
  providerMessageId String?   @map("provider_message_id")
  failureReason     String?   @map("failure_reason")
  scheduledAt       DateTime? @map("scheduled_at")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status, scheduledAt])
  @@map("notification_deliveries")
}

model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorType    String   @map("actor_type")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([requestId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  status        String
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}
