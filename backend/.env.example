# Runtime
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartura
FRONTEND_URL=http://localhost:3000
# Comma-separated additional browser origins. Leave empty when none are needed.
CORS_ORIGINS=

# Authentication
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_JWT_EXPIRES_IN_SECONDS=900
BETTER_AUTH_SESSION_EXPIRES_IN_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Administrative bootstrap and development seed
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_EMAIL=admin@cartura.test
SUPER_ADMIN_FIRST_NAME=Cartura
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_PASSWORD=
DEV_SEED_PASSWORD=CarturaDev123!

# Transactional email
MAIL_FROM=Cartura <no-reply@cartura.local>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=cartura
MEDIA_PENDING_TTL_HOURS=24
MEDIA_DELETE_CLAIM_TTL_MINUTES=15
MEDIA_CLEANUP_POLL_INTERVAL_MS=3600000
MEDIA_CLEANUP_BATCH_SIZE=100

# Paymob payments
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WEBHOOK_URL=
PAYMOB_REDIRECTION_URL=
PAYMOB_INTENTION_EXPIRATION_SECONDS=3600
PAYMOB_REFUND_ENDPOINT=

# Redis, scheduled work, and cache
REDIS_URL=redis://localhost:6379
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TTL_SECONDS=60
BULLMQ_PREFIX=cartura
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=cartura:rl:api

# Trusted reverse proxy and BFF authentication. Keep disabled only in local development.
TRUST_PROXY=
INTERNAL_API_AUTH_MODE=disabled
INTERNAL_API_SHARED_SECRET=
VERCEL_OIDC_ISSUER=
VERCEL_OIDC_AUDIENCE=
VERCEL_OIDC_SUBJECT=

BACKGROUND_WORKERS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_DELIVERY_POLL_INTERVAL_MS=10000
STALE_ORDER_POLL_INTERVAL_MS=60000
STALE_ORDER_BATCH_SIZE=25
